<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TibiaHuntAnalyzer.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="TibiaHuntAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/tibia-hunt-analyzer.ico"
        Title="Tibia Hunt Analyzer"
        MinWidth="640"
        MinHeight="480">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <Button Grid.Row="0"
                Content="⚙ Configurações"
                Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Right"
                IsVisible="{Binding IsHome}"
                AutomationProperties.Name="Configurações" />

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}" />

        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="created by" />
                <HyperlinkButton Content="Aislan Michel"
                                 NavigateUri="{Binding CreatorProfileUrl}"
                                 ToolTip.Tip="https://github.com/aislan-michel"
                                 AutomationProperties.Name="Aislan Michel GitHub profile" />
            </StackPanel>
            <TextBlock Text="{Binding ApplicationVersion}"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </Grid>
</Window>
