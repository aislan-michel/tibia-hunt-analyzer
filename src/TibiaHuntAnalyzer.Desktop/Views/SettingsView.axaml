<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TibiaHuntAnalyzer.Desktop.ViewModels"
             x:Class="TibiaHuntAnalyzer.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          RowSpacing="14"
          Margin="0,24,0,0">
        <TextBlock Grid.Row="0"
                   Text="Configurações"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Banco de dados atualmente ativo"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveDatabasePath}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Caminho configurado"
                       FontWeight="SemiBold" />
            <TextBox Text="{Binding DatabasePath}"
                     AutomationProperties.Name="Caminho do banco de dados configurado" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Selecionar banco existente"
                        Command="{Binding BrowseExistingDatabaseCommand}" />
                <Button Content="Escolher local para novo banco"
                        Command="{Binding BrowseNewDatabaseLocationCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="{Binding ExitButtonText}"
                    Command="{Binding ExitCommand}"
                    MinWidth="120" />
            <Button Content="Salvar"
                    Command="{Binding SaveCommand}"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</UserControl>
