<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TibiaHuntAnalyzer.Desktop.ViewModels"
             x:Class="TibiaHuntAnalyzer.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
        <TextBlock Text="Tibia Hunt Analyzer"
                   FontSize="28"
                   HorizontalAlignment="Center" />
        <Button Content="Inserir Hunt Analyzer"
                Command="{Binding InsertCommand}"
                MinWidth="280"
                MinHeight="48"
                HorizontalAlignment="Center" />
        <Button Content="Consultar Hunt Analyzer"
                Command="{Binding QueryCommand}"
                MinWidth="280"
                MinHeight="48"
                HorizontalAlignment="Center" />
        <Button Content="Analisar Hunt Analyzer"
                Command="{Binding OpenAnalyticsCommand}"
                MinWidth="280"
                MinHeight="48"
                HorizontalAlignment="Center" />
        <Button Content="Backup e restauração"
                Command="{Binding OpenBackupRestoreCommand}"
                MinWidth="280"
                MinHeight="48"
                HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
